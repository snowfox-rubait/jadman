# Maintainer: snowfox-rubait <266122632+snowfox-rubait@users.noreply.github.com>
pkgname=jadman-bin
pkgver=0.1.9
pkgrel=1
pkgdesc="Advanced Browser-Integrated Download Manager (Pre-compiled Binaries)"
arch=('x86_64')
url="https://github.com/snowfox-rubait/jadman"
license=('GPL3')
depends=('openssl' 'aria2' 'yt-dlp' 'ffmpeg')
provides=('jadman' 'jadm-daemon' 'jadm-tui')
conflicts=('jadman' 'jadman-git')
source=(
  "https://github.com/snowfox-rubait/jadman/releases/download/v$pkgver/jadman-x86_64-unknown-linux-gnu.tar.gz"
  "jadman-source-$pkgver.tar.gz::https://github.com/snowfox-rubait/jadman/archive/refs/tags/v$pkgver.tar.gz"
)
sha256sums=(
  '8921415824e771db97637ed46c8d4c1cb56149ea0723567987a6841cfb899f2d'
  '3f036a90b902e8b6aaffcfd248b8b129767a2f9f29af3d1a40f2cb36e0cd1929'
)

package() {
  # Install precompiled binaries
  install -Dm755 "${srcdir}/jadm-daemon" "${pkgdir}/usr/bin/jadm-daemon"
  install -Dm755 "${srcdir}/jadm-tui" "${pkgdir}/usr/bin/jadm-tui"

  # Install browser extensions
  install -d "${pkgdir}/usr/share/jadman/extension"
  cp -r "${srcdir}/jadman-$pkgver/extension/chrome" "${pkgdir}/usr/share/jadman/extension/chrome"
  cp -r "${srcdir}/jadman-$pkgver/extension/firefox" "${pkgdir}/usr/share/jadman/extension/firefox"
}
